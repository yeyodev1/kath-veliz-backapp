# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/kath-veliz
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@cliente.com
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Alumno demo ──────────────────────────────────────────────────────
# Cuenta para ver la plataforma "como alumno". Se siembra con pnpm seed:student.
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# ─── Payphone (Cajita de Pagos) ───────────────────────────────────────
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# ─── Bunny Stream ─────────────────────────────────────────────────────
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_KEY=
BUNNY_ACCOUNT_API_KEY=
# Llave de Token Authentication del embed (Security de la librería).
BUNNY_TOKEN_AUTH_KEY=

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kath Veliz <team@kathveliz.com>

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
